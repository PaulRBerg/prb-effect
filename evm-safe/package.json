{
  "name": "@prb/effect-evm-safe",
  "version": "6.0.0",
  "description": "Effect-TS integration for Safe Apps",
  "keywords": [
    "effect",
    "effect-ts",
    "evm",
    "safe",
    "safe-apps",
    "multisig",
    "typescript",
    "web3"
  ],
  "homepage": "https://github.com/PaulRBerg/prb-effect/tree/main/evm-safe#readme",
  "bugs": {
    "url": "https://github.com/PaulRBerg/prb-effect/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PaulRBerg/prb-effect.git",
    "directory": "evm-safe"
  },
  "license": "MIT",
  "author": {
    "name": "Paul Razvan Berg",
    "url": "https://github.com/PaulRBerg"
  },
  "sideEffects": false,
  "type": "module",
  "imports": {
    "#src/*": {
      "source": "./src/*",
      "default": "./dist/*"
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./internal/*": null,
    "./*": {
      "types": "./dist/*/index.d.ts",
      "import": "./dist/*/index.js",
      "default": "./dist/*/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "just build",
    "prepack": "bun install --frozen-lockfile && just build"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:dev",
    "@effect/vitest": "catalog:dev",
    "@prb/devkit": "catalog:dev",
    "@prb/effect-evm": "workspace:*",
    "@safe-global/safe-apps-sdk": "9.1.0",
    "@types/node": "catalog:dev",
    "@types/react": "catalog:dev",
    "@types/react-dom": "catalog:dev",
    "@typescript/native-preview": "catalog:dev",
    "@vitest/ui": "catalog:dev",
    "@wagmi/core": "^2.22.1",
    "effect": "catalog:effect",
    "jsdom": "catalog:dev",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:dev",
    "viem": "^2.57.7",
    "vitest": "catalog:dev",
    "wagmi": "^2.19.5"
  },
  "peerDependencies": {
    "@prb/effect-evm": "^5.0.0",
    "@safe-global/safe-apps-sdk": "catalog:peers",
    "@wagmi/core": "catalog:peers",
    "effect": "catalog:peers",
    "react": "catalog:peers",
    "react-dom": "catalog:peers",
    "viem": "catalog:peers",
    "wagmi": "^2.19.5"
  },
  "peerDependenciesMeta": {
    "@wagmi/core": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "wagmi": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
