{
  "name": "@prb/effect-evm",
  "description": "Effect-TS integration for Ethereum Virtual Machine (EVM) frontend development",
  "homepage": "https://github.com/PaulRBerg/prb-effect/tree/main/evm#readme",
  "main": "./dist/index.js",
  "sideEffects": false,
  "type": "module",
  "types": "./dist/index.d.ts",
  "version": "2.1.2",
  "scripts": {
    "build": "just build",
    "prepack": "bun install --frozen-lockfile && just build"
  },
  "author": {
    "name": "Paul Razvan Berg",
    "url": "https://github.com/PaulRBerg"
  },
  "license": "MIT",
  "repository": {
    "directory": "evm",
    "type": "git",
    "url": "git+https://github.com/PaulRBerg/prb-effect.git"
  },
  "bugs": {
    "url": "https://github.com/PaulRBerg/prb-effect/issues"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:dev",
    "@effect/platform": "catalog:effect",
    "@effect/vitest": "catalog:dev",
    "@sablier/devkit": "catalog:dev",
    "@types/node": "catalog:dev",
    "@types/react": "catalog:dev",
    "@types/react-dom": "catalog:dev",
    "@typescript/native-preview": "catalog:dev",
    "@vitest/ui": "catalog:dev",
    "@wagmi/core": "^2.22.1",
    "effect": "catalog:effect",
    "jsdom": "catalog:dev",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:dev",
    "viem": "^2.43.1",
    "vitest": "catalog:dev",
    "wagmi": "^2.19.5"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./internal/*": null,
    "./*": {
      "types": "./dist/*/index.d.ts",
      "import": "./dist/*/index.js",
      "default": "./dist/*/index.js"
    }
  },
  "files": [
    "dist/**",
    "CHANGELOG.md",
    "DOCS.md"
  ],
  "keywords": [
    "effect",
    "effect-ts",
    "ethereum",
    "evm",
    "react",
    "typescript",
    "viem",
    "wagmi",
    "web3"
  ],
  "peerDependencies": {
    "@effect/platform": "catalog:peers",
    "@wagmi/core": "catalog:peers",
    "effect": "catalog:peers",
    "react": "catalog:peers",
    "react-dom": "catalog:peers",
    "viem": "catalog:peers"
  },
  "peerDependenciesMeta": {
    "@wagmi/core": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "imports": {
    "#src/*": {
      "source": "./src/*",
      "default": "./dist/*"
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
