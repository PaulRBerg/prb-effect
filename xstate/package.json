{
  "name": "@prb/effect-xstate",
  "version": "4.0.0",
  "description": "Effect-TS and xState v5 workflow utilities",
  "keywords": [
    "effect",
    "effect-ts",
    "react",
    "state-machine",
    "typescript",
    "workflow",
    "xstate"
  ],
  "homepage": "https://github.com/PaulRBerg/prb-effect/tree/main/xstate#readme",
  "bugs": {
    "url": "https://github.com/PaulRBerg/prb-effect/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PaulRBerg/prb-effect.git",
    "directory": "xstate"
  },
  "license": "MIT",
  "author": {
    "name": "Paul Razvan Berg",
    "url": "https://github.com/PaulRBerg"
  },
  "sideEffects": false,
  "type": "module",
  "imports": {
    "#src/*": {
      "source": "./src/*",
      "default": "./dist/*"
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./internal/*": null,
    "./*": {
      "types": "./dist/*/index.d.ts",
      "import": "./dist/*/index.js",
      "default": "./dist/*/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "just build",
    "prepack": "bun install --frozen-lockfile && just build"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:dev",
    "@effect/vitest": "catalog:dev",
    "@prb/devkit": "catalog:dev",
    "@types/node": "catalog:dev",
    "@types/react": "catalog:dev",
    "@typescript/native-preview": "catalog:dev",
    "@vitest/ui": "catalog:dev",
    "@xstate/react": "^6.1.0",
    "effect": "catalog:effect",
    "react": "catalog:",
    "typescript": "catalog:dev",
    "vitest": "catalog:dev",
    "xstate": "^5.33.3"
  },
  "peerDependencies": {
    "@xstate/react": "catalog:peers",
    "effect": "catalog:peers",
    "react": "catalog:peers",
    "xstate": "catalog:peers"
  },
  "peerDependenciesMeta": {
    "@xstate/react": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
