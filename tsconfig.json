{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./node_modules/@sablier/devkit/tsconfig/base.json",
  "exclude": ["./node_modules", "./evm", "./next", "./xstate"],
  "include": ["*.ts"],
  "compilerOptions": {
    "lib": ["ESNext", "DOM"],
    "jsx": "react-jsx",
    "types": ["node", "vitest/globals"],
    "paths": {
      "@prb/effect-next": ["./next/src"],
      "@prb/effect-next/*": ["./next/src/*"],
      "@prb/effect-evm": ["./evm/src"],
      "@prb/effect-evm/*": ["./evm/src/*"]
    }
  }
}
