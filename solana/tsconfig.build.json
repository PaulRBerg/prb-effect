{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../node_modules/@sablier/devkit/tsconfig/build.json",
  "compilerOptions": {
    "lib": ["ESNext", "DOM"],
    "jsx": "react-jsx",
    "outDir": "./dist",
    "rootDir": "./src",
    "paths": {
      "@/src": ["./src"],
      "@/src/*": ["./src/*"]
    }
  },
  "exclude": ["./node_modules", "./src/**/*.test.ts"],
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
