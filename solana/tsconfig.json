{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "lib": ["ESNext", "DOM"],
    "jsx": "react-jsx",
    "paths": {
      "@/src": ["./src"],
      "@/src/*": ["./src/*"]
    }
  },
  "exclude": ["**/node_modules/", "dist/"],
  "include": [
    // Directories
    "src/",
    // Files
    "vitest.*.ts",
    "../vitest.shared.ts"
  ]
}
