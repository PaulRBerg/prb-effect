{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../node_modules/@sablier/devkit/tsconfig/build.json",
  "compilerOptions": {
    "lib": ["ESNext", "DOM"],
    "jsx": "react-jsx",
    "outDir": "./dist",
    "rootDir": "./src",
    "customConditions": ["source"]
  },
  "exclude": ["**/node_modules/", "src/**/*.test.ts", "src/**/*.test.tsx"],
  "include": [
    // Directories
    "src/"
  ]
}
