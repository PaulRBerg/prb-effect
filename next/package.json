{
  "name": "@prb/effect-next",
  "description": "Effect-TS integration for Next.js",
  "homepage": "https://github.com/PaulRBerg/prb-effect/tree/main/next#readme",
  "license": "MIT",
  "main": "./dist/index.js",
  "sideEffects": false,
  "type": "module",
  "types": "./dist/index.d.ts",
  "version": "1.2.0",
  "scripts": {
    "build": "just build",
    "prepack": "bun install --frozen-lockfile && just build"
  },
  "author": {
    "name": "Paul Razvan Berg",
    "url": "https://github.com/PaulRBerg"
  },
  "repository": {
    "directory": "next",
    "type": "git",
    "url": "git+https://github.com/PaulRBerg/prb-effect.git"
  },
  "bugs": {
    "url": "https://github.com/PaulRBerg/prb-effect/issues"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:dev",
    "@effect/opentelemetry": "^0.63.0",
    "@effect/platform": "catalog:effect",
    "@effect/vitest": "catalog:dev",
    "@prb/devkit": "catalog:dev",
    "@types/node": "catalog:dev",
    "@types/react": "catalog:dev",
    "@types/react-dom": "catalog:dev",
    "@typescript/native-preview": "catalog:dev",
    "@vitest/ui": "catalog:dev",
    "effect": "catalog:effect",
    "next": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "server-only": "catalog:",
    "typescript": "catalog:dev",
    "vitest": "catalog:dev"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./internal/*": null,
    "./*": {
      "types": "./dist/*/index.d.ts",
      "import": "./dist/*/index.js",
      "default": "./dist/*/index.js"
    }
  },
  "files": [
    "dist/**",
    "CHANGELOG.md"
  ],
  "keywords": [
    "effect",
    "effect-ts",
    "next",
    "nextjs",
    "react",
    "server-actions",
    "server-components",
    "typescript"
  ],
  "peerDependencies": {
    "@effect/opentelemetry": "^0.63.0",
    "@effect/platform": "catalog:peers",
    "effect": "catalog:peers",
    "next": "catalog:peers",
    "react": "catalog:peers",
    "react-dom": "catalog:peers"
  },
  "peerDependenciesMeta": {
    "@effect/opentelemetry": {
      "optional": true
    },
    "@effect/platform": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "imports": {
    "#src/*": {
      "source": "./src/*",
      "default": "./dist/*"
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
