{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "root": true,
  "extends": ["ultracite/core", "@sablier/devkit/biome/base", "@sablier/devkit/biome/ui"],
  "files": {
    "includes": ["**/*.{js,json,jsonc,ts,tsx}", "!**/node_modules", "!**/dist"]
  },
  "linter": {
    "rules": {
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": ["@/src/**/*.js", "!@/src/index.js", "!@/src/**/index.js"],
                "message": "Import from barrel file (index.js) instead of implementation file."
              }
            ]
          }
        }
      }
    }
  },
  "overrides": [
    // Allow any imports from index.ts and internal files
    {
      "includes": ["**/index.ts", "**/internal/*.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": "off"
          }
        }
      }
    },
    // Allow `any` type in test files
    {
      "includes": ["**/*.test.ts", "**/*.test.integration.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off"
          }
        }
      }
    }
  ]
}
